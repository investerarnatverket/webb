# Kopiera till .env.local (lokalt) och lägg samma värden i Netlify:
# Site configuration -> Environment variables. Ingen av dem får committas.

# Sajtens adress, utan avslutande snedstreck. Används i bekräftelselänkar.
SAJT_URL=http://localhost:3000

# Publicerad Outlook-kalender (ICS). När den finns är den källan för alla event.
# Outlook.com: Inställningar -> Kalender -> Delade kalendrar -> Publicera en kalender.
# Behandla den som hemlig: den som har länken kan läsa hela kalendern.
KALENDER_ICS_URL=

# Supabase -> Project Settings -> API Keys
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Hemlig nyckel: kringgår all radsäkerhet. Bara på servern, aldrig i webbläsaren.
SUPABASE_SECRET_KEY=sb_secret_...

# Resend -> API Keys (behörighet "Full access" behövs för kontakter)
RESEND_API_KEY=re_...
# Avsändaren måste ligga på en domän som är verifierad i Resend.
RESEND_FROM=Investerarnätverket <hej@investerarnatverket.se>
# Valfritt: segmentet som prenumeranterna läggs i (Resend -> Audience -> Segments).
RESEND_SEGMENT_ID=
# Svar på utskicken hamnar här, t.ex. nätverkets Outlook-adress.
KONTAKT_EPOST=natverket@outlook.com

# Signerar bekräftelselänkarna. Skapa med: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRENUMERATION_HEMLIGHET=
